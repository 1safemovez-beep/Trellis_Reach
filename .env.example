# Copy this file to .env.local for local work, and add the same values in your host's
# environment settings (Vercel → Project → Settings → Environment Variables).
# Never commit real keys. .env.local is already in .gitignore.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic → console.anthropic.com → API Keys (server only)
ANTHROPIC_API_KEY=your-anthropic-key
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-5-5

# Public site address, used in links
NEXT_PUBLIC_SITE_URL=https://qvtrellis.net
